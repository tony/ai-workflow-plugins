.claude/
.DS_Store
__pycache__/
*.pyc
docs/superpowers/
plugins/*/evals/results/

# Routing eval suite output (cross-plugin cases live at the repo root)
evals/results/

# Resuming from a case's history_file writes a fresh session transcript beside
# it, inside the case directory
plugins/*/evals/*/*.jsonl
!plugins/*/evals/*/history.jsonl
evals/*/*.jsonl
!evals/*/history.jsonl
